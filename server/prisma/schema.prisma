generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  SUPER_ADMIN
  REGISTRATION_REVIEWER
  FINANCE
  GATE_STAFF
  SUPPORT
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_CREATED
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
  EXPIRED
  REFUNDED
}

enum TicketStatus {
  INACTIVE
  ACTIVE
  CHECKED_IN
  REVOKED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  displayName             String
  passwordHash            String                   @map("password_hash")
  role                    Role                     @default(PARTICIPANT)
  active                  Boolean                  @default(true)
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  sessions                Session[]
  registrations           Registration[]
  audits                  AuditLog[]               @relation("AuditActor")
  verifiedInvoices        Invoice[]                @relation("InvoiceVerifier")
  checkedInTickets        Ticket[]                 @relation("TicketCheckInActor")
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  csrfHash   String    @map("csrf_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Competition {
  id                   String         @id @default(uuid()) @db.Uuid
  slug                 String         @unique
  name                 String
  level                String
  discipline           String
  description          String?
  eventId              String         @map("event_id")
  eventName            String         @map("event_name")
  fee                  Int
  currency             String         @default("IDR")
  active               Boolean        @default(true)
  registrationDeadline DateTime       @map("registration_deadline")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  registrations        Registration[]

  @@index([active, registrationDeadline])
  @@map("competitions")
}

model Registration {
  id                 String             @id @default(uuid()) @db.Uuid
  registrationNumber String             @unique @map("registration_number")
  ownerId            String             @map("owner_id") @db.Uuid
  competitionId      String             @map("competition_id") @db.Uuid
  teamName           String             @map("team_name")
  institution        String
  phone              String?
  status             RegistrationStatus @default(DRAFT)
  reviewReason       String?            @map("review_reason")
  submittedAt        DateTime?          @map("submitted_at")
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  competition        Competition        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  members            TeamMember[]
  documents          Document[]
  invoice            Invoice?
  ticket             Ticket?

  @@index([ownerId])
  @@index([competitionId, status])
  @@map("registrations")
}

model TeamMember {
  id             String         @id @default(uuid()) @db.Uuid
  registrationId String         @map("registration_id") @db.Uuid
  name           String
  studentId      String?        @map("student_id")
  role           TeamMemberRole @default(MEMBER)
  email          String?
  phone          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("team_members")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  category       String
  originalName   String       @map("original_name")
  mimeType       String       @map("mime_type")
  size           Int
  storageKey     String       @unique @map("storage_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("documents")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  registrationId     String        @unique @map("registration_id") @db.Uuid
  invoiceNumber      String        @unique @map("invoice_number")
  amount             Int
  currency           String        @default("IDR")
  provider           String        @default("MANUAL")
  instructions       Json
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  deadline           DateTime
  proofStorageKey    String?       @map("proof_storage_key")
  proofOriginalName  String?       @map("proof_original_name")
  proofMimeType      String?       @map("proof_mime_type")
  proofSize          Int?          @map("proof_size")
  verificationReason String?       @map("verification_reason")
  verifiedAt         DateTime?     @map("verified_at")
  verifiedById       String?       @map("verified_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  registration       Registration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  verifiedBy         User?         @relation("InvoiceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([paymentStatus])
  @@index([verifiedById])
  @@map("invoices")
}

model Ticket {
  id               String       @id @default(uuid()) @db.Uuid
  registrationId   String       @unique @map("registration_id") @db.Uuid
  tokenHash        String       @unique @map("token_hash")
  status           TicketStatus @default(ACTIVE)
  issuedAt         DateTime     @default(now()) @map("issued_at")
  checkedInAt      DateTime?    @map("checked_in_at")
  checkedInById    String?      @map("checked_in_by_id") @db.Uuid
  revokedAt        DateTime?    @map("revoked_at")
  revocationReason String?      @map("revocation_reason")
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  checkedInBy      User?        @relation("TicketCheckInActor", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([checkedInById])
  @@map("tickets")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  requestId  String   @map("request_id")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model EmailOutbox {
  id          String       @id @default(uuid()) @db.Uuid
  to          String
  subject     String
  body        String
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(8) @map("max_attempts")
  availableAt DateTime     @default(now()) @map("available_at")
  lockedUntil DateTime?    @map("locked_until")
  workerToken String?      @map("worker_token")
  lastError   String?      @map("last_error")
  sentAt      DateTime?    @map("sent_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("email_outbox")
}

# Create the unprivileged service account during installation:
# useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin jrc-monitor
# Required public HTTPS origin
JRC_PUBLIC_URL=https://example.com

# Required full release commit SHA
JRC_EXPECTED_RELEASE_SHA=0000000000000000000000000000000000000000

# Optional settings
JRC_TLS_WARNING_DAYS=14
JRC_RELEASE_MARKER_PATH=/release.json
# JRC_ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/replace-me

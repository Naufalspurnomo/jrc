{
  "name": "jrc-xiv-server",
  "private": true,
  "version": "1.0.0",
  "description": "JRC XIV registration, payment, ticketing, and check-in API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint \"{src,test,prisma}/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "env -u COOKIE_NAME -u COOKIE_SAME_SITE -u COOKIE_SECURE -u STORAGE_DRIVER -u STORAGE_PATH -u SUPABASE_URL -u SUPABASE_SERVICE_ROLE_KEY -u SUPABASE_STORAGE_BUCKET NODE_ENV=test vitest run --config vitest.config.mts",
    "test:watch": "env -u COOKIE_NAME -u COOKIE_SAME_SITE -u COOKIE_SECURE -u STORAGE_DRIVER -u STORAGE_PATH -u SUPABASE_URL -u SUPABASE_SERVICE_ROLE_KEY -u SUPABASE_STORAGE_BUCKET NODE_ENV=test vitest --config vitest.config.mts",
    "test:e2e": "env -u COOKIE_NAME -u COOKIE_SAME_SITE -u COOKIE_SECURE -u SUPABASE_URL -u SUPABASE_SERVICE_ROLE_KEY -u SUPABASE_STORAGE_BUCKET STORAGE_DRIVER=local NODE_ENV=test RUN_E2E=1 vitest run --config vitest.config.mts test/system.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.13",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.1.0",
    "multer": "2.5.0",
    "nestjs-pino": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "multer": "$multer",
    "body-parser": "2.4.0",
    "fast-uri": "4.2.3",
    "glob": "14.0.3",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "minimatch": "11.0.4",
    "source-map-js": "1.2.2",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "deepmerge-ts": "8.0.2"
  }
}

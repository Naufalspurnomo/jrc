# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Use 1 in production when Apache is the single trusted proxy hop.
TRUST_PROXY_HOPS=0

# Database and browser access
DATABASE_URL=postgresql://USER:***@localhost:5432/jrc
# Compose uses the private service hostname. Percent-encode reserved password characters.
COMPOSE_DATABASE_URL=postgresql://jrc:replace-me-url-encoded-password@jrc-db:5432/jrc?schema=public
POSTGRES_DB=jrc
POSTGRES_USER=jrc
POSTGRES_PASSWORD=replace-me-with-a-long-random-database-password
CORS_ORIGINS=http://localhost:5173

# Session and ticket security
COOKIE_NAME=jrc_session
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
TICKET_SECRET=replace-me-with-a-long-random-secret

# File storage
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760

# Public URLs
# Never put secrets in VITE_* variables; frontend environment values are public.
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_VERIFICATION_URL=http://localhost:5173/ticket/verify

# Event
EVENT_ID=JRC-XIV-2026
EVENT_NAME="JRC XIV 2026"
REGISTRATION_DEADLINE=2026-10-15T23:59:59+07:00
CURRENCY=IDR

# Competition fees, in whole currency units
TRANSPORTER_SD_FEE=250000
RESCUE_SMP_FEE=300000
SHOOTER_SMA_FEE=350000
LINE_FOLLOWER_FEE=300000
SUMO_FEE=300000
SOCCER_FEE=350000

# Manual payment
# Payment proof is evidence only; it does not confirm settlement.
PAYMENT_PROVIDER=MANUAL
PAYMENT_BANK_NAME=replace-me-bank-name
PAYMENT_ACCOUNT_NAME=replace-me-account-name
PAYMENT_ACCOUNT_NUMBER=replace-me-account-number
PAYMENT_QRIS_IMAGE_URL=
PAYMENT_DEADLINE_DAYS=3

# Email
EMAIL_TRANSPORT=console
EMAIL_POLL_INTERVAL_MS=5000
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me-smtp-user
SMTP_APP_PASSWORD=replace-me-smtp-app-password
SMTP_FROM="JRC XIV <noreply@example.invalid>"

# Logging
LOG_LEVEL=info

# Optional seed staff accounts. Leave blank unless explicitly provisioning them.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_REGISTRATION_REVIEWER_EMAIL=
SEED_REGISTRATION_REVIEWER_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=
SEED_GATE_STAFF_EMAIL=
SEED_GATE_STAFF_PASSWORD=
SEED_SUPPORT_EMAIL=
SEED_SUPPORT_PASSWORD=
